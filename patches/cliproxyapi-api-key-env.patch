diff --git a/internal/config/openai_compat_env_test.go b/internal/config/openai_compat_env_test.go
new file mode 100644
--- /dev/null
+++ b/internal/config/openai_compat_env_test.go
@@ -0,0 +1,33 @@
+package config
+
+import "testing"
+
+func TestOpenAICompatibilityAPIKeyResolvedAPIKey(t *testing.T) {
+	t.Run("environment variable takes precedence", func(t *testing.T) {
+		t.Setenv("CLIPROXY_TEST_API_KEY", "  runtime-key  ")
+		entry := OpenAICompatibilityAPIKey{
+			APIKey:    "literal-key",
+			APIKeyEnv: "CLIPROXY_TEST_API_KEY",
+		}
+		if got := entry.ResolvedAPIKey(); got != "runtime-key" {
+			t.Fatalf("ResolvedAPIKey() = %q, want runtime-key", got)
+		}
+	})
+
+	t.Run("missing environment variable does not fall back to literal", func(t *testing.T) {
+		entry := OpenAICompatibilityAPIKey{
+			APIKey:    "literal-key",
+			APIKeyEnv: "CLIPROXY_TEST_API_KEY_MISSING",
+		}
+		if got := entry.ResolvedAPIKey(); got != "" {
+			t.Fatalf("ResolvedAPIKey() = %q, want empty string", got)
+		}
+	})
+
+	t.Run("literal key remains supported", func(t *testing.T) {
+		entry := OpenAICompatibilityAPIKey{APIKey: "  literal-key  "}
+		if got := entry.ResolvedAPIKey(); got != "literal-key" {
+			t.Fatalf("ResolvedAPIKey() = %q, want literal-key", got)
+		}
+	})
+}
